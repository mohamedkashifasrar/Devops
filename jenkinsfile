pipeline {
    agent any

    tools {
        nodejs 'frontend'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/mohamedkashifasrar/Devops.git'
            }
        }

        stage('Install') {
            steps {
                sh 'npm install'
            }
       }
        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }
    }
}
