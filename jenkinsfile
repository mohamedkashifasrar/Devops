pipeline {
  agent any

  tools {
    nodejs 'frontend'
  }

  stages {
    stage('Checkout') {
      steps { 
         git branch: 'main',
         credentialsId: 'git-creds',
         url: 'https://github.com/mohamedkashifasrar/Devops.git'
      }
   }

    stage('Install') {
        steps {
           sh 'npm install'
        }
   }
#    stage('build') {
 #       steps {
  #          sh 'npm run build'
   #   }  
   # }
  }
}
